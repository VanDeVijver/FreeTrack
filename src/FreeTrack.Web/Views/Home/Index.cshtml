@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@* Full paths: ContactController re-renders this view when its form is invalid, and partial lookup there searches Views/Contact. *@
@await Html.PartialAsync("~/Views/Home/_Hero.cshtml", Model)
@await Html.PartialAsync("~/Views/Home/_Services.cshtml", Model)
@await Html.PartialAsync("~/Views/Home/_Rooms.cshtml", Model)
@await Html.PartialAsync("~/Views/Home/_Contact.cshtml", Model)
