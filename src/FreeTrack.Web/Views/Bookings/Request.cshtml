@model BookingRequestViewModel
@{
    ViewData["Title"] = $"Aanvraag — {Model.RoomName}";
}

<section class="contact-section">
    <p class="kicker">BOEKINGSAANVRAAG</p>
    <h1 class="display-heading">@Model.RoomName <span class="display-heading__accent">boeken.</span></h1>
    <p>Dit is een aanvraag, geen directe bevestiging. We laten binnen enkele dagen weten of het lukt.</p>

    <div asp-validation-summary="ModelOnly" class="contact-form__error"></div>

    <form action="/Bookings/Request" method="post" class="contact-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoomId" />
        <input type="hidden" asp-for="RoomSlug" />

        <div class="contact-form__row">
            <div class="contact-form__field">
                <label asp-for="CustomerName"></label>
                <input asp-for="CustomerName" />
                <span asp-validation-for="CustomerName" class="contact-form__error"></span>
            </div>
            <div class="contact-form__field">
                <label asp-for="CustomerEmail"></label>
                <input asp-for="CustomerEmail" type="email" />
                <span asp-validation-for="CustomerEmail" class="contact-form__error"></span>
            </div>
        </div>

        <div class="contact-form__row">
            <div class="contact-form__field">
                <label asp-for="CustomerPhone"></label>
                <input asp-for="CustomerPhone" />
            </div>
            <div></div>
        </div>

        <div class="contact-form__row">
            <div class="contact-form__field">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" type="date" />
            </div>
            <div class="contact-form__field">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" type="date" />
            </div>
        </div>

        <div class="contact-form__field">
            <label asp-for="Message"></label>
            <textarea asp-for="Message" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn--primary">Aanvraag versturen <span aria-hidden="true">&rarr;</span></button>
    </form>
</section>
